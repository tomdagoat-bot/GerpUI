local PropertiesCACH = {}

local function HasProperty(Object: Instance, Property: string): boolean
	local Class = Object.ClassName
	local ClassCache = PropertiesCACH[Class]

	if not ClassCache then
		ClassCache = {}
		PropertiesCACH[Class] = ClassCache
	end

	local Cached = ClassCache[Property]
	if Cached ~= nil then
		return Cached
	end

	local Success = pcall(function()
		local _ = Object[Property]
	end)
	ClassCache[Property] = Success
	return Success
end

local function Rebuild(Original, Changes)
	local Result : typeof(Original) = {}

	for Key, Value in Original do
		Result[Key] = Value
	end
	if Changes then
		for Key, Value in Changes do
			Result[Key] = Value
		end
	end

	return Result
end

local TweenInfos = {
	["Sway"] = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	["Linear"] = TweenInfo.new(0.6, Enum.EasingStyle.Linear, Enum.EasingDirection.In),
	["ComeIn"] = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
	["Pop"] = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	["Pop?"] = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	["Linear2"] = TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.In),
}

local function Tween(
	info: {
		Properties: string | {},
		GuiObject: GuiObject | Instance,
		Tweening: string,
		Goal: any,
		OnEnd: () -> (),
	}
): Tween
	if typeof(info.Properties) == "string" then
		info.Properties = {[info.Properties] = info.Goal}
	end

	local TI
	if typeof(info.Tweening) == "string" then
		TI = TweenInfos[info.Tweening] or TweenInfos.Linear
	elseif info.Tweening then
		TI = info.Tweening
	else
		TI = TweenInfos.Linear
	end

	local Result = TweenService:Create(info.GuiObject, TI, info.Properties)
	Result:Play()
	if info.OnEnd then
		Result.Completed:Once(info.OnEnd)
	end
	return Result
end

local MainProperties = {"BackgroundTransparency", "TextTransparency", "TextStrokeTransparency", "ImageTransparency"}

local function Window_UIObject(Frame, CustomTheme)
	if Frame.Name == "Bar" then
		Frame.BackgroundColor3 = CustomTheme["Bar"]
		Frame.BackgroundTransparency = CustomTheme["Bar Transparency"]
	elseif Frame.Name == "Fill" then
		Frame.BackgroundColor3 = CustomTheme["Light Color"]
		Frame.BackgroundTransparency = CustomTheme["Fill Transparency"]
	elseif Frame.Name == "Toggle" and Frame:IsA("TextButton") then
		Frame.BackgroundColor3 = Frame:HasTag("Enabled") and CustomTheme["Toggled"] or CustomTheme["Not Toggled"]
	end

	if Frame:GetAttribute("Main-UI") or Frame:GetAttribute("Secondary-UI") or Frame:GetAttribute("Tertiary-UI") then
		Frame.BackgroundColor3 = Frame:GetAttribute("Main-UI") and CustomTheme["Main Background"]
			or Frame:GetAttribute("Secondary-UI") and CustomTheme["Secondary"]
			or CustomTheme["Tertiary"]
		Frame.BackgroundTransparency = Frame:GetAttribute("Main-UI") and CustomTheme["Background Transparency"]
			or Frame:GetAttribute("Secondary-UI") and CustomTheme["Secondary Transparency"]
			or CustomTheme["Tertiary Transparency"]
	end

	for _, Prop in MainProperties do
		if HasProperty(Frame, Prop) then
			Frame:SetAttribute(Prop, Frame[Prop])
		end
	end

	if HasProperty(Frame, "Image") and Frame.Name == "Icon" then
		Frame.ImageColor3 = CustomTheme["Icon Color"]
		Frame.ImageTransparency = CustomTheme["Icon Transparency"]
	end
end

local function Window_TextObject(TextLabel, CustomTheme, Font)
	TextLabel.FontFace = Font
	TextLabel.TextColor3 = TextLabel:GetAttribute("Secondary-Text") and CustomTheme["Secondary Text Color"] or CustomTheme["Main Text Color"]
	TextLabel.TextTransparency = TextLabel:GetAttribute("Secondary-Text") and CustomTheme["Secondary Text Transparency"] or CustomTheme["Main Text Transparency"]
end

local function HideSystem(UiObj)
	local Properties = {BackgroundTransparency = 1}
	if HasProperty(UiObj, "Text") then
		Properties["TextTransparency"] = 1
		Properties["TextStrokeTransparency"] = 1
	elseif HasProperty(UiObj, "Image") then
		Properties["ImageTransparency"] = 1
	end
	Tween({
		GuiObject = UiObj,
		Tweening = "Linear",
		Properties = Properties,
		OnEnd = function()
			UiObj.Visible = false
		end,
	})
end

local function ShowSystem(UiObj)
	if not UiObj:HasTag("NoVisible") then
		UiObj.Visible = true
	end
	local Properties = {}
	for Prop, Val in UiObj:GetAttributes() do
		if HasProperty(UiObj, Prop) then
			Properties[Prop] = Val
		end
	end
	Tween({GuiObject = UiObj, Tweening = "Linear", Properties = Properties})
end

local function Hide(Obj, ApplyToObj)
	for _, UiObj in Obj:QueryDescendants("GuiObject") do
		HideSystem(UiObj)
	end
	if ApplyToObj then
		HideSystem(Obj)
	end
end

local function Show(Obj, ApplyToObj)
	for _, UiObj in Obj:QueryDescendants("GuiObject") do
		ShowSystem(UiObj)
	end
	if ApplyToObj then
		ShowSystem(Obj)
	end
end

