function TOGGLE_METATABLE:Toggle(override)
	local C = override ~= nil and override or true
	if self.Enabled then
		self:Disable(C)
	else
		self:Enable(C)
	end
end

function TOGGLE_METATABLE:Enable(real)
	local C =  self.Section.Tab.Window.Theme

	if self.Toggle_UI.Name == "Toggle" then
		Tween({GuiObject = self.Circle,Tweening = "Pop",Properties = "Position",Goal = self.Circle:GetAttribute("On")})
	else
		Tween({GuiObject = self.Mark,Tweening = "Linear2",Properties = "TextTransparency",Goal = C["Main Text Transparency"]})
	end

	Tween({GuiObject = self.Button,Tweening = "Linear2",Properties = "BackgroundColor3",Goal = C["Toggled"]})
	Tween({GuiObject = self.Button.Glow,Tweening = "Linear2",Properties = "Color",Goal = C["Toggled"]})	

	if real then
		self.Enabled = not self.Enabled
		self.Button:AddTag("Enabled")
		self.OnToggle(true)
	end
end

function TOGGLE_METATABLE:Disable(real)
	local C =  self.Section.Tab.Window.Theme

	if self.Toggle_UI.Name == "Toggle" then
		Tween({GuiObject = self.Circle,Tweening = "Pop",Properties = "Position",Goal = self.Circle:GetAttribute("Off")})
	else
		Tween({GuiObject = self.Mark,Tweening = "Linear2",Properties = "TextTransparency",Goal = 1})
	end

	local bg = self.Toggle_UI.Name == "Toggle" and C["Not Toggled"] or C["Secondary"]

	Tween({GuiObject = self.Button,Tweening = "Linear2",Properties = "BackgroundColor3",Goal = bg})
	Tween({GuiObject = self.Button.Glow,Tweening = "Linear2",Properties = "Color",Goal = bg})

	if real then
		self.Enabled = not self.Enabled
		self.Button:RemoveTag("Enabled")
		self.OnToggle(false)
	end
end

