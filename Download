local ReplicatedStorage = game:GetService("ReplicatedStorage")

local URL_UI = "https://github.com/tomdagoat-bot/GerpUI/raw/refs/heads/main/GerpUI.rbxm"

if not isfile("GerpUI.rbxm") then
    local data = game:HttpGet(URL_UI)
    writefile("GerpUI.rbxm", data)
end

local Gui = game:GetObjects(getcustomasset("GerpUI.rbxm"))[1]
Gui.Parent = ReplicatedStorage

local URL_Assets = "https://github.com/tomdagoat-bot/GerpUI/raw/refs/heads/main/Assets.rbxm"

if not isfile("Assets.rbxm") then
    local data = game:HttpGet(URL_Assets)
    writefile("Assets.rbxm", data)
end

local Assets = game:GetObjects(getcustomasset("Assets.rbxm"))[1]
Assets.Parent = ReplicatedStorage
