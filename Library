for _, metatable in pairs(METATABLES) do
	function metatable:BindInput(Input)
		Inputs[Enum.KeyCode[Input]] = function()
			local Type__ = self.Type
			local func = Type__ == "Button" and self.Click or self.Toggle

			if func then
				func(self,true)
			end
		end
	end
end

UserInputService.InputBegan:Connect(function(inp,g)
	if g then return end

	CallFunction(Inputs[inp.KeyCode])
end)

return GerpUI
