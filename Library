local RNG = Random.new()

function GerpUI:Window(info)
	local UIInstance = Gui:Clone()
	UIInstance.Parent = gethui()

	local self = setmetatable({}, WINDOW_METATABLE)
	self.Tabs = {}
	self.Instance = UIInstance
	self.UI = UIInstance.Hub
	self.Buttons = self.UI:WaitForChild("Buttons")
	self.Comm = self.UI:WaitForChild("Communicate")
	self.Contents = self.UI:WaitForChild("Content")
	self.TabsUI = self.UI:WaitForChild("Tabs")
	self.BackgroundImage = self.UI:WaitForChild("Background")
	self.Icon = self.UI:WaitForChild("Icon")
	self.Title = self.UI:WaitForChild("Name")
	self.Credits = self.UI:WaitForChild("Credit")
	self.Version = self.UI:WaitForChild("Version")
	self.Welcome = self.Comm:WaitForChild("Executed")
	self.Empty = self.Comm:WaitForChild("Empty")

	local WindowInfo = Rebuild(Window_Information, info)
	self.Window_Info = WindowInfo
	self.Empty.e.Image = WindowInfo["Empty Tab Image"]

	--[[ Theme ]]
	self:SetTheme(WindowInfo["Theme"])

	--[[ Loading Screen ]]--
	self.UI.ClipsDescendants = true
	self.Welcome.Welcome.Text = WindowInfo["Welcome Message"]
	self.Welcome.Description.Text = WindowInfo["Welcome Description"]
	self.Welcome.Icon.Image = WindowInfo["Icon"]
	self.UI.Position = self.UI:GetAttribute("StartPos")
	self.UI.Size = self.UI:GetAttribute("Size")
	self.UI.Background.Visible = WindowInfo["Use Background Image"]
	self.UI.Background.ImageTransparency = 1
	self.Contents.Size = self.Contents:GetAttribute("startSize")

	for _, UiObj in self.UI:GetChildren() do
		if UiObj:IsA("GuiObject") and UiObj:GetAttribute("StartPos") then
			UiObj.Position = UiObj:GetAttribute("StartPos")
		end
	end

	Hide(self.Empty)

	task.spawn(function()
		self:Intro()
	end)

	--[[ The Custom Stuff ]]
	self.Icon.Image = WindowInfo["Icon"]
	self.Title.Text = WindowInfo["Name"]
	self.Version.Text = WindowInfo["Version"]
	self.Credits.Text = WindowInfo["Credit"]
	self.Version.Visible = WindowInfo["Display Version"]

	if WindowInfo.Transparent then
		self.UI.BackgroundTransparency = WindowInfo["Transparency"]
		self.Buttons.BackgroundTransparency = WindowInfo["Transparency"]
	else
		self.UI.BackgroundTransparency = 0
		self.Buttons.BackgroundTransparency = 0
	end

	self.UI.DescendantAdded:Connect(function(UIObj)
		if not UIObj:IsA("GuiObject") then
			return
		end
		Window_UIObject(UIObj, self.Theme)
		if HasProperty(UIObj, "Text") then
			Window_TextObject(UIObj, self.Theme, self.Window_Info.Font)
		end
	end)

	return self
end

function WINDOW_METATABLE:Intro()
	local UI = self.UI
	local WindowInfo = self.Window_Info

	Tween({GuiObject = UI, Tweening = "Sway", Properties = "Position", Goal = UI:GetAttribute("Position")}).Completed:Wait()
	task.wait(1)

	local LoadingDuration = typeof(WindowInfo["Loading Duration"]) == "number"
		and WindowInfo["Loading Duration"]
		or RNG:NextNumber(WindowInfo["Loading Duration"][1], WindowInfo["Loading Duration"][2])

	if WindowInfo["Loading Screen"] then
		self.Comm.Visible = true
		self.Welcome.Icon.Image = WindowInfo["Icon"]

		Tween({GuiObject = self.Comm, Tweening = "Sway", Properties = "Position", Goal = self.Comm:GetAttribute("secondpos")}).Completed:Wait()
		Tween({GuiObject = UI:WaitForChild("Shadow"), Properties = "Transparency", Goal = UI.Shadow:GetAttribute("Transparency"), Tweening = "Linear"})
		task.wait(0.5)

		Tween({
			GuiObject = self.Welcome.Bar.Fill,
			Tweening = TweenInfo.new(LoadingDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
			Properties = "Size",
			Goal = UDim2.fromScale(1, 1),
		}).Completed:Wait()

		Hide(self.Welcome)
		task.wait(TweenInfos.Linear.Time)
		self.Welcome:Destroy()
		self.Welcome = nil
	else
		self.Welcome:Destroy()
		self.Welcome = nil
		Tween({GuiObject = UI:WaitForChild("Shadow"), Properties = "Transparency", Goal = UI.Shadow:GetAttribute("Transparency"), Tweening = "Linear"})
	end

	Tween({GuiObject = UI, Tweening = "Sway", Properties = "Size", Goal = UI:GetAttribute("finalsize")}).Completed:Wait()

	if WindowInfo["Use Background Image"] then
		UI.Background.Image = WindowInfo["Background Image"]
		Tween({GuiObject = UI:WaitForChild("Background"), Properties = "ImageTransparency", Goal = WindowInfo["Background Transparency"], Tweening = "Linear"})
	end

	local LastComeIn
	for _, UiObj in UI:GetChildren() do
		if not UiObj:IsA("GuiObject") then
			continue
		end
		local Properties = {Position = UiObj:GetAttribute("Position")}
		if UiObj:GetAttribute("Size") then
			Properties["Size"] = UiObj:GetAttribute("Size")
		end
		LastComeIn = Tween({GuiObject = UiObj, Tweening = "ComeIn", Properties = Properties})
		task.wait(0.1)
	end

	UI.Drag.Enabled = WindowInfo["Draggable"]
	if LastComeIn then
		LastComeIn.Completed:Wait()
	end
	UI.ClipsDescendants = false

	self.Buttons.Size = self.Buttons:GetAttribute("startSize")
	local ButtonsSizeTween = Tween({GuiObject = self.Buttons, Tweening = "ComeIn", Properties = "Size", Goal = self.Buttons:GetAttribute("Size")})

	task.spawn(function()
		ButtonsSizeTween.Completed:Wait()
		for _, UiObj in self.Buttons.List:GetChildren() do
			if not UiObj:IsA("GuiObject") then
				continue
			end
			task.wait(0.15)
			Tween({GuiObject = UiObj, Tweening = "Pop?", Properties = "Size", Goal = UiObj:GetAttribute("Size")})
		end
	end)

	task.wait(TweenInfos.ComeIn.Time / 2 - 0.15)
	Tween({GuiObject = UI.Corner, Tweening = "Linear", Properties = "TopRightRadius", Goal = UDim.new(0, 0)})
end

function WINDOW_METATABLE:SetTheme(Name)
	local CustomTheme = GerpUI.Themes[Name] or DefaultTheme
	self.UI.BackgroundColor3 = CustomTheme["Main Background"]
	self.UI.Shadow.Color = CustomTheme["Main Background"]

	for _, UiObj in self.UI:QueryDescendants("GuiObject") do
		Window_UIObject(UiObj, CustomTheme)
		if HasProperty(UiObj, "Text") then
			Window_TextObject(UiObj, CustomTheme, self.Window_Info.Font)
		end
	end

	self.Theme = CustomTheme
end

local TAB_METATABLE = {}
TAB_METATABLE.__index = TAB_METATABLE

function WINDOW_METATABLE:CreateTab(info)
	local Window = self
	local self = setmetatable({}, TAB_METATABLE)
	local TabSettings = Rebuild(Tab_Information, info)

	self.Name = TabSettings["Name"]
	self.Enabled = TabSettings["Enabled"]
	self.Window = Window

	self.UI = Assets.Tab:Clone()
	self.UI.Parent = Window.TabsUI
	self.Icon = self.UI.Icon
	self.UI.Text = TabSettings["Name"]
	self.Icon.Image = TabSettings["Icon"]
	self.Icon.Visible = TabSettings["Show Icon"]
	self.UI.LayoutOrder = TabSettings["Show Icon"] and 0 or 1 -- tabs with no icons go to the bottom

	Window.Tabs[TabSettings["Name"]] = self

	self.UI.MouseButton1Click:Connect(function()
		self:Toggle()
	end)

	if self.Enabled then
		self:Enable()
	end

	return self
end

function TAB_METATABLE:Toggle()
	self.Enabled = not self.Enabled

	if self.Enabled then
		self:Enable()
		for _, Tab in self.Window.Tabs do
			if Tab == self then
				continue
			end
			Tab:Disable()
		end
	else
		self:Disable()
	end

	if not self.Content and self.Enabled then
		Show(self.Window.Empty)
	else
		Hide(self.Window.Empty)
	end
end

function TAB_METATABLE:Enable()
	self.Icon.Shadow.Enabled = true
	local ImageColor = self.Icon:GetAttribute("Color") or self.Window.Theme["Light Color"]

	Tween({GuiObject = self.UI, Tweening = "Linear2", Properties = "TextColor3", Goal = self.UI:GetAttribute("Color") or self.Window.Theme["Light Color"]})
	Tween({GuiObject = self.Icon, Tweening = "Linear2", Properties = "ImageColor3", Goal = ImageColor})
	self.Icon.Shadow.Color = ImageColor
	Tween({GuiObject = self.Icon.Shadow, Tweening = "Linear2", Properties = "Transparency", Goal = 0.35})
	self.Enabled = true

	if self.Content then
		for _, Section in self.Content do
			Show(Section.UI, true)
		end
	end
end

function TAB_METATABLE:Disable()
	Tween({GuiObject = self.Icon, Tweening = "Linear2", Properties = "ImageColor3", Goal = self.Window.Theme["Icon Color"]})
	Tween({GuiObject = self.UI, Tweening = "Linear2", Properties = "TextColor3", Goal = self.Window.Theme["Main Text Color"]})
	Tween({
		GuiObject = self.Icon.Shadow,
		Tweening = "Linear2",
		Properties = "Transparency",
		Goal = 1,
		OnEnd = function()
			self.Icon.Shadow.Enabled = false
		end,
	})
	self.Enabled = false

	if self.Content then
		for _, Section in self.Content do
			Hide(Section.UI, true)
		end
	end
end

local SECTION_METATABLE = {}
SECTION_METATABLE.__index = SECTION_METATABLE

function TAB_METATABLE:CreateSection(info)
	local Tab = self

	if not Tab.Content then
		Tab.Content = {}
	end

	local self = setmetatable({}, SECTION_METATABLE)
	local SectionSettings = Rebuild(Section_Information, info)

	self.Tab = Tab
	self.Name = SectionSettings["Name"]

	self.UI = Assets.Section:Clone()
	self.UI.Parent = Tab.Window.Contents

	self.Information = self.UI:WaitForChild("Information")
	self.Content_UI = self.UI:WaitForChild("Contents") -- container that holds each element

	if Tab.Enabled then
		Show(self.UI, true)
	else
		Hide(self.UI, true)
	end

	self.Content_UI.List.Padding = SectionSettings["Padding"]

	self.Information.Visible = (SectionSettings["Name"] and SectionSettings["Description"]) ~= nil

	if SectionSettings["Name"] then
		self.Information.Title.Text = SectionSettings["Name"]
	end
	if SectionSettings["Description"] then
		self.Information.Description.Text = SectionSettings["Description"]
	end

	self.Content_UI.ChildAdded:Connect(function(b)
		self.Content_UI:RemoveTag("NoVisible")
		self.Content_UI.Visible = true

		if Tab.Enabled then
			Show(b, true)
		else
			Hide(b, true)
		end
	end)

	Tab.Content[SectionSettings["Name"]] = self
	return self
end

