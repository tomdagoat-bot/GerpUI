	self.Button = self.Toggle_UI.Button

	-- Could Be Nil!

	--
	self.Circle = self.Button:FindFirstChild("Click")
	self.Mark = self.Button:FindFirstChild("Mark")
	--

	self.Enabled = ToggleSettings["Enabled"]
	self.OnToggle = ToggleSettings["CallBack"]

